# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Wirtualne środowiska
.venv/
venv/

# Pliki środowiskowe (lokalne)
.env
*.env
.env.*

# Rider-voice artefakty
/tmp/
tmp/
voice-recs/
recordings/
*.wav
*.mp3
*.ogg

# Konfiguracje aplikacji
!config/*.toml          # śledzimy domyślne TOML-e (np. voice.toml)
config/local*.toml      # ignorujemy lokalne warianty
config/secret*.toml     # ignorujemy sekrety
!config/*.example.toml  # (opcjonalnie) śledź pliki .example.toml

# Systemd build artefacts
*.service~
*.socket~

# Dane/artefakty (ignoruj cały katalog data/)
data/
# jeśli chcesz zostawić pusty katalog w repo:
#!data/.gitkeep
*.bak*
config/voice.local.override.toml
scripts/fix_logger_event.py
