# ---------------------------------------------------------------------------
# Rider-Pi / config/alsa/asoundrc.wm8960
# ALSA dla WM8960 (CM4) – wariant MIN (bez dmix/dsnoop, 100% po ID).
# - ID karty: "wm8960soundcard" (sprawdź `aplay -l`)
# - Brak odwołań hw:0 / card 0
# - Używamy nazwanych aliasów: wm8960_out (playback), wm8960_in (capture)
# ---------------------------------------------------------------------------

# Domyślny kontroler – inaczej `aplay -L` potrafi zgłosić "Invalid CTL hw:0"
ctl.!default {
  type hw
  card "wm8960soundcard"
}

# Surowe urządzenia HW po ID
pcm.wm8960_hw_playback {
  type hw
  card   "wm8960soundcard"
  device 0
}
pcm.wm8960_hw_capture {
  type hw
  card   "wm8960soundcard"
  device 0
}

# Alias PLAYBACK (plug → HW)
pcm.wm8960_out {
  type plug
  slave.pcm "wm8960_hw_playback"
}
ctl.wm8960_out { type hw card "wm8960soundcard" }

# Alias CAPTURE (plug → HW)
pcm.wm8960_in {
  type plug
  slave.pcm "wm8960_hw_capture"
}
ctl.wm8960_in { type hw card "wm8960soundcard" }
