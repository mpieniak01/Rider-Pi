[Unit]
Description=JupyterLab (manual developer tool)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/pi
ExecStart=/usr/bin/python3 -u /home/pi/robot/apps/jupyter_runner.py
User=pi
Group=pi
Restart=always
RestartSec=10
MemoryHigh=150M
MemoryMax=220M

