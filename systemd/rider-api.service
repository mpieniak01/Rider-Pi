[Unit]
Description=Rider-Pi API (HTTP/SSE)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/robot

# Stabilne importy i logowanie
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONFAULTHANDLER=1
Environment=PYTHONPATH=/home/pi/robot
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8

# Limity / time-outy (dostosuj w razie potrzeby)
Environment=SAFE_MAX_DURATION=0.25
Environment=WEB_BRIDGE_TIMEOUT=0.8

# === ŚCIEŻKI SNAPSHOTÓW (spójne z services/api_core/compat.py) ===
Environment=SNAP_DIR=/home/pi/robot/snapshots
Environment=RAW_PATH=/home/pi/robot/snapshots/raw.jpg
Environment=PROC_PATH=/home/pi/robot/snapshots/proc.jpg
Environment=SSD_PATH=/home/pi/robot/snapshots/ssd.jpg

# Sekrety (GOOGLE_*) wyłącznie w ~/.bash_profile
# Świadomie bez EnvironmentFile.

# Serwer API — na :8080 (zgodne z UI)
Environment=API_HOST=0.0.0.0
Environment=API_PORT=8080
Environment=STATUS_API_PORT=8080

# „Świeżość” klatek dla /camera/*
Environment=SNAP_MAX_AGE_S=300

# Proxy do mostka ruchu (puste = nie używaj)
Environment=WEB_BRIDGE_URL=

# Voice (nowe, lokalny voice-web) + legacy zmienne dla zgodności
Environment=VOICE_WEB_BASE=http://127.0.0.1:8092
Environment=VOICE_HTTP_TIMEOUT=45
Environment=VOICE_TTS_URL=http://127.0.0.1:8092/api/tts
Environment=VOICE_ASR_URL=http://127.0.0.1:8092/api/asr

# BUS (SSE)
Environment=BUS_PUB_PORT=5555
Environment=BUS_SUB_PORT=5556
Environment=BUS_RCVHWM=100
Environment=BUS_CONFLATE=0

# XGO RO (domyślnie wyłączone)
Environment=ENABLE_XGO_RO=0
# Environment=XGO_RO_PORT=/dev/ttyUSB0

# HOME jawnie (asekuracja dla ładowania profilu)
Environment=HOME=/home/pi

# Diagnostyka startu (pojawia się w journald)
ExecStartPre=/bin/bash -lc 'echo "[rider-api] sourcing $HOME/.bash_profile i start services.api_server" | systemd-cat -t rider-api-env -p info'

# Start serwera:
# - set -a => auto-eksport zmiennych z profilu
# - bezpieczne źródłowanie profilu (tylko gdy plik istnieje)
# - exec python (żeby środowisko trafiło do procesu)
ExecStart=/bin/bash -lc 'set -a; [ -r "$HOME/.bash_profile" ] && . "$HOME/.bash_profile"; set +a; exec /usr/bin/python3 -u -m services.api_server'

Restart=always
RestartSec=0.5
TimeoutStartSec=10
TimeoutStopSec=5
KillMode=process
KillSignal=SIGINT
Nice=-5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
