[Unit]
Description=Rider-Pi Boot Prepare (vendor cleanup, splash, LCD off)
After=systemd-tmpfiles-setup.service sysinit.target local-fs.target basic.target
Before=display-manager.service lightdm.service rider-broker.service rider-vision.service
ConditionPathExists=!/run/rider/boot-prepared

[Service]
Type=oneshot
WorkingDirectory=/home/pi/robot

EnvironmentFile=-/etc/default/rider-boot-prepare
Environment=PYTHONPATH=/home/pi/robot

# Splash (LCD 2")
Environment=SPLASH_USE=xgo
Environment=SPLASH_ROTATE=270
Environment=SPLASH_SECONDS=10
Environment=SPLASH_REFRESH_EVERY=0.2
Environment=SPLASH_EARLY_EXIT=0

# Czekanie
Environment=WAIT_IP=3
Environment=WAIT_BATT=1
Environment=SPLASH_IFACES=wlan0,eth0

# UART
Environment=XGO_UART_PORTS=/dev/ttyAMA0

# Po splashu
Environment=SPLASH_CLEAR=0
Environment=KEEP_BL_ON=1
Environment=LCD_BL_GPIO=0
# Uwaga: wartość z przestrzeniami MUSI być w cudzysłowie
Environment="LCD_OFF_CMD=/usr/bin/make -C /home/pi/robot lcd-off"
Environment=XGO_BL_GPIO=-1

# Timingi / rysowanie
Environment=BOOT_VENDOR_GRACE=2
Environment=SPLASH_KEY_W=150
Environment=SPLASH_LINE_EXTRA=6
Environment=SPLASH_IP_SPACER=2

# Nie ruszaj procesów display (ważne!)
Environment=NO_KILL_DISPLAY=1

# SDL/pygame
Environment=SDL_VIDEODRIVER=
Environment=SDL_FBDEV=
Environment=SDL_AUDIODRIVER=dummy
Environment=PYGAME_HIDE_SUPPORT_PROMPT=1

# --- włącz LCD PRZED splashem ---
ExecStartPre=/usr/bin/make -C /home/pi/robot lcd-on

StandardOutput=journal
StandardError=journal
TimeoutStartSec=90

RuntimeDirectory=rider
RemainAfterExit=yes

# Główna sekwencja (skrypt w repo)
ExecStart=/home/pi/robot/scripts/sys_boot-prepare.sh

[Install]
WantedBy=multi-user.target
