[Unit]
Description=Rider-Pi Obstacle detector (ROI on edges -> bus/state)
After=network-online.target rider-edge-preview.service
Wants=network-online.target rider-edge-preview.service
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/robot

# (Świadomie brak EnvironmentFile, by nic nas nie nadpisywało)

# --- I/O ---
Environment=SNAP_DIR=/home/pi/robot/snapshots
Environment=PROC_PATH=/home/pi/robot/snapshots/proc.jpg
#Environment=RAW_PATH=/home/pi/robot/snapshots/raw.jpg
Environment=DATA_DIR=/home/pi/robot/data
Environment=OBSTACLE_JSON=/home/pi/robot/data/obstacle.json

# --- ROI ---
Environment=ROI_Y0=0.55
Environment=ROI_H=0.40

# --- Progi/histereza (MAŁO krawędzi => przeszkoda) ---
Environment=EDGE_T_LOW=0.10
Environment=EDGE_T_HIGH=0.18
Environment=DARK_LUMA=0.15
Environment=LAPL_VAR_MIN=30.0
Environment=CONF_GAIN=4.0
Environment=OBST_DEC_N=3
Environment=SNAP_MAX_AGE_S=3.0

# Legacy tylko do diag
Environment=EDGE_AREA_PCT=0.18
Environment=EDGE_PIX_MIN=16000

# --- Annotacje (WŁĄCZONE) ---
Environment=OBST_ANN=1
Environment=OBST_ANN_PATH=/home/pi/robot/snapshots/obst_annot.jpg
Environment=OBST_BINS=24
Environment=EDGE_BIN_LOW=0.06

# PUB + logging
Environment=PUBLISH=1
Environment=PYTHONUNBUFFERED=1

ExecStartPre=/bin/mkdir -p /home/pi/robot/snapshots /home/pi/robot/data
ExecStart=/usr/bin/python3 -u apps/vision/obstacle_roi.py

Restart=always
RestartSec=0.5
TimeoutStartSec=10
TimeoutStopSec=5
KillMode=process
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target