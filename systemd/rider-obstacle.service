[Unit]
Description=Rider-Pi Obstacle detector (ROI on edges -> bus/state)
After=network-online.target rider-edge-preview.service
Wants=network-online.target rider-edge-preview.service
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/robot

# Globalne ENV (opcjonalne, jeśli istnieją)
EnvironmentFile=-/etc/default/rider
EnvironmentFile=-/etc/default/rider-obstacle

# --- I/O: ścieżki snapów i danych ---
# Źródło klatek (PROC z edge-preview)
Environment=SNAP_DIR=/home/pi/robot/snapshots
Environment=PROC_PATH=/home/pi/robot/snapshots/proc.jpg
# Katalog i plik wyniku detektora
Environment=DATA_DIR=/home/pi/robot/data
Environment=OBSTACLE_JSON=/home/pi/robot/data/obstacle.json

# --- ROI + progi (domyślnie dół obrazu) ---
Environment=ROI_Y0=0.55
Environment=ROI_H=0.40
# Progi detekcji:
# Przy logach edge_pct≈0.08–0.13 podbijamy domyślnie tak,
# aby „pusta scena” nie była stale present=True.
Environment=EDGE_AREA_PCT=0.18     # udział krawędzi w ROI (0.18 = 18%)
Environment=EDGE_PIX_MIN=16000     # minimalna liczba pikseli krawędzi w ROI

# Debounce (ile kolejnych próbek musi potwierdzać stan)
Environment=OBST_DEC_N=3

# Świeżość ramek — dane starsze oznacz jako 'stale'
Environment=SNAP_MAX_AGE_S=3.0

# Publikacja do bus/state (gdy obstacle_roi.py to wspiera)
Environment=PUBLISH=1

# Bezpieczny, jednoznaczny logging bez buforowania (dodatkowo do -u)
Environment=PYTHONUNBUFFERED=1

# Pre-hook: zapewnij katalogi
ExecStartPre=/bin/mkdir -p /home/pi/robot/snapshots /home/pi/robot/data

# Detektor
ExecStart=/usr/bin/python3 -u apps/vision/obstacle_roi.py

Restart=always
RestartSec=0.5
TimeoutStartSec=10
TimeoutStopSec=5
KillMode=process
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
