[Unit]
Description=Rider-Pi Odometry (Position Tracking)
After=network-online.target rider-broker.service motion-executor.service
Wants=network-online.target rider-broker.service motion-executor.service
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/robot

# --- Bus Configuration ---
Environment=BUS_XPUB=tcp://127.0.0.1:5556
Environment=BUS_XSUB=tcp://127.0.0.1:5555

# --- Odometry Configuration ---
Environment=ODOMETRY_LOG_LEVEL=INFO
Environment=ODOMETRY_UPDATE_RATE_HZ=10.0
Environment=ODOMETRY_PUBLISH_RATE_HZ=5.0

# --- Initial Position ---
Environment=ODOMETRY_INITIAL_X=0.0
Environment=ODOMETRY_INITIAL_Y=0.0
Environment=ODOMETRY_INITIAL_THETA=0.0

# --- Motion Model Parameters ---
# Linear speed scale: m/s per unit normalized speed (0-1)
Environment=ODOMETRY_LINEAR_SPEED_SCALE=0.2
# Angular speed scale: rad/s per unit normalized speed (0-1)
Environment=ODOMETRY_ANGULAR_SPEED_SCALE=1.0
# IMU timeout: fall back to dead reckoning after this duration without IMU data (seconds)
Environment=ODOMETRY_IMU_TIMEOUT_S=1.0

ExecStart=/usr/bin/python3 -u -m apps.odometry.main

Restart=always
RestartSec=0.5
TimeoutStartSec=10
TimeoutStopSec=5
KillMode=process
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
