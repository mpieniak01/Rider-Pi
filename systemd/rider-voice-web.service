[Unit]
Description=Rider Voice Web API
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/pi/robot

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/robot

# Najpierw user site-packages (tu masz piper-tts), potem moduły z repo
Environment=PYTHONPATH=/home/pi/.local/lib/python3.9/site-packages:/home/pi/robot

# Modele trzymamy w repo
Environment=PIPER_MODEL_DIR=/home/pi/robot/models/piper
Environment=VOSK_MODEL_DIR=/home/pi/robot/models/vosk/vosk-model-small-pl-0.22

# Jeśli chcesz tylko TTS po HTTP, możesz wyłączyć ASR:
# Environment=ASR_BACKEND=none
# Jeśli chcesz również /api/asr -> zostaw/lub włącz vosk:
Environment=ASR_BACKEND=vosk

Environment=PYTHONUNBUFFERED=1
Environment=LOG_LEVEL=DEBUG

ExecStart=/usr/bin/python3 -m apps.voice.web --bind 0.0.0.0:8092

Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

