[Unit]
Description=Rider Voice Web API
After=network-online.target rider-voice.service
Wants=network-online.target
ConditionPathExists=/home/pi/robot

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/robot
EnvironmentFile=-/etc/rider/voice.env
ExecStart=/usr/bin/python3 -m apps.voice.web --bind 0.0.0.0:8092
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
