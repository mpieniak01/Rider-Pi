[Unit]
Description=Rider Voice Assistant (CLI listener using local web ASR/TTS)
After=network-online.target sound.target rider-voice-web.service
Wants=network-online.target rider-voice-web.service
ConditionPathExists=/home/pi/robot

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/robot

# Wszystko w repo
Environment=PYTHONPATH=/home/pi/robot
Environment=VOICE_FILE_CFG=/home/pi/robot/config/voice_local_file.toml
Environment=PIPER_MODEL_DIR=/home/pi/robot/models/piper
Environment=VOSK_MODEL_DIR=/home/pi/robot/models/vosk/vosk-model-small-pl-0.22
Environment=ASR_BACKEND=vosk
Environment=PYTHONUNBUFFERED=1

# CLI wymaga --config (inaczej "Config path is required")
ExecStart=/usr/bin/python3 -m apps.voice.cli --config ${VOICE_FILE_CFG} listen

Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
