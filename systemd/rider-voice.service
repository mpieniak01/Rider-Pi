[Unit]
Description=Rider Voice Assistant Service
After=network-online.target sound.target
Wants=network-online.target
ConditionPathExists=/home/pi/robot

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/robot

# Uruchamiaj przez loginowego basha, żeby wczytać ~/.bash_profile (OPENAI_API_KEY)
ExecStart=/bin/bash -l -c 'cd /home/pi/robot && /usr/bin/python3 -m apps.voice.cli listen'

Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
