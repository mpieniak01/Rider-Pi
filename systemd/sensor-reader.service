[Unit]
Description=Rider-Pi Sensor BUS Projection (no UART ownership)
After=network-online.target rider-broker.service motion-executor.service
Wants=network-online.target rider-broker.service motion-executor.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/robot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/pi/robot
ExecStart=/usr/bin/python3 -u -m apps.motion.sensor_reader
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
