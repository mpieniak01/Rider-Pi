[Unit]
Description=Unblock Wi-Fi radio before network configuration
After=local-fs.target systemd-rfkill.service
Before=dhcpcd.service connman.service network-pre.target
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/sbin/rfkill unblock wifi
# dhcpcd owns the interface and starts its wpa_supplicant hook.
# Do not access wlan0 here: the radio can appear before the network interface.
RemainAfterExit=yes
TimeoutStartSec=5

[Install]
WantedBy=multi-user.target
